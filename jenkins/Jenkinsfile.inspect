pipeline {
    // Single-node Jenkins: use the available built-in executor without a label.
    agent any
    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 90, unit: 'MINUTES')
        buildDiscarder(logRotator(daysToKeepStr: '5', numToKeepStr: '5', artifactDaysToKeepStr: '10', artifactNumToKeepStr: '20'))
    }
    parameters {
        choice(name: 'ENVIRONMENT', choices: ['test', 'production'], description: 'Configured inventory environment')
        string(name: 'TARGETS', defaultValue: '10.178.42.150', description: 'Inventory host IPs, comma separated')
        choice(name: 'TASK', choices: ['basic', 'system', 'storage', 'processes', 'network', 'logs', 'directory', 'service_status', 'dns', 'tcp', 'http', 'journal', 'access_log'], description: 'Read-only task')
        text(name: 'TASK_PARAMS', defaultValue: '{}', description: 'Task-specific JSON object; see deployment guide')
    }
    stages {
        stage('Checkout') {
            steps {
                deleteDir()
                script {
                    checkout([
                        $class: 'GitSCM',
                        branches: scm.branches,
                        extensions: scm.extensions,
                        userRemoteConfigs: [[
                            url: 'https://github.com/lzhang121/sre-toolkit.git',
                            credentialsId: '5534438f-2103-424f-b35b-8d17a4c5db42'
                        ]]
                    ])
                }
            }
        }
        stage('Inspect') {
            steps {
                script {
                    def ops = load 'jenkins/common.groovy'
                    def settings = ops.prepare('run')
                    ops.execute(settings)
                }
            }
        }
    }
    post {
        always {
            script {
                if (fileExists('jenkins/common.groovy')) {
                    def ops = load 'jenkins/common.groovy'
                    ops.archive()
                    if (fileExists('reports/run/index.html')) {
                        publishHTML(target: [
                            reportDir: 'reports/run',
                            reportFiles: 'index.html',
                            reportName: 'SRE Report',
                            includes: '*.html',
                            keepAll: true,
                            alwaysLinkToLastBuild: true,
                            allowMissing: false
                        ])
                    }
                }
            }
        }
    }
}
