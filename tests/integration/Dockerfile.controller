FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssh-client bash git tar gzip && rm -rf /var/lib/apt/lists/*
WORKDIR /work
COPY requirements-controller.txt /tmp/requirements-controller.txt
RUN pip install --no-cache-dir -r /tmp/requirements-controller.txt
COPY . /work
CMD ["sleep", "infinity"]
