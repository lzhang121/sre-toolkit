# 使用 export 设置；脚本不会自动 source 配置文件。
# 可选通知：HTTPS webhook；当前不支持钉钉加签。
# DINGTALK_WEBHOOK=
# ALERT_EMAIL=
LOG_DIR=/var/log/sre-toolkit
LOG_LEVEL=INFO
CPU_THRESHOLD=80
MEM_THRESHOLD=80
DISK_THRESHOLD=80
INODE_THRESHOLD=80
# 1 分钟负载除以在线 CPU 数量
LOAD_THRESHOLD=1
DISK_PATH=/
CONCURRENCY=8
TIMEOUT=3
BACKUP_DIR=/var/backups/sre-toolkit
